# Default uses real Neo4j. Copy this file to .env and set your local credentials.
WORKSPACE_BACKEND=neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
DEMO_MODE=true
MATCH_AUTO_THRESHOLD=80
# Explicit optional fallback for an offline demonstration:
# WORKSPACE_BACKEND=sqlite-demo
# WORKSPACE_DB=backend/data/workspace.sqlite
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
