CREATE CONSTRAINT IF NOT EXISTS FOR (n:InvestigationWorkspace) REQUIRE n.workspace_id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:InvestigationEntity) REQUIRE n.entity_id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:ImportJob) REQUIRE n.job_id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:SourcedClaim) REQUIRE n.claim_id IS UNIQUE;
